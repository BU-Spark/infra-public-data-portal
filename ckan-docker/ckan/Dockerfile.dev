# Dockerfile.dev
FROM ckan/ckan-base:ckan-2.10.0-dev

# 1) Environment
ENV APP_DIR=/srv/app \
    CKAN_SRC=/usr/lib/ckan/default/src/ckan \
    TZ=UTC \
    CKAN_INI=${APP_DIR}/config/ckan.ini

# 2) Timezone (optional)
RUN echo "${TZ}" > /etc/timezone \
 && cp /usr/share/zoneinfo/${TZ} /etc/localtime || true

# 3) Prepare directories & permissions
USER root
RUN mkdir -p \
      ${APP_DIR}/config \
      ${CKAN_SRC}/ckan/public/base/i18n \
 && chmod -R a+rwX ${APP_DIR} \
 && chmod -R a+rwX ${CKAN_SRC}/ckan/public/base/i18n \
 && chmod -R a+rX ${APP_DIR}

# 4) Override supervisord.conf, then remove any chown directive
COPY setup/supervisord.conf /etc/supervisord.conf
RUN sed -i '/^chown\s*=/d' /etc/supervisord.conf \
 && rm -f /etc/supervisord.d/*.conf

# 5) Copy in your entry-point scripts
COPY setup/start_ckan.sh ${APP_DIR}/start_ckan.sh
COPY setup/prerun.py     ${APP_DIR}/prerun.py
RUN chmod +x ${APP_DIR}/start_ckan.sh

# 6) Apply any extension patches as CKAN user (safe if empty)
COPY patches ${APP_DIR}/patches

# ensure patch exists (no-op if already installed)
USER root
RUN apt-get update && apt-get install -y patch && rm -rf /var/lib/apt/lists/* || true
RUN apk add --no-cache patch || true

USER 900
RUN if [ -d "${APP_DIR}/patches" ] && [ "$(ls -A ${APP_DIR}/patches 2>/dev/null)" ]; then \
      for d in ${APP_DIR}/patches/*; do \
        if [ -d "$d" ]; then \
          for p in "$d"/*.patch; do \
            if [ -f "$p" ]; then \
              cd ${CKAN_SRC}/$(basename "$d") && patch -p1 < "$p" || true; \
            fi; \
          done; \
        fi; \
      done; \
    else \
      echo "[Dockerfile] No patches to apply"; \
    fi

# 7) Final sweep: ensure APP_DIR is world-readable
USER root
RUN chmod -R a+rwX ${APP_DIR}

# Install ckanext-spark
USER root

# Ensure git exists (keep the one that matches your base image)
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/* || true
RUN apk add --no-cache git || true

# Put extensions under /srv/app/src_extensions
RUN mkdir -p /srv/app/src_extensions

# Pin to a commit or tag if you can
ARG SPARK_EXT_REF=main

RUN git clone https://github.com/BU-Spark/ckanext-spark.git /srv/app/src_extensions/ckanext-spark \
 && cd /srv/app/src_extensions/ckanext-spark \
 && git checkout ${SPARK_EXT_REF} \
 && pip install -e . \
 && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi


# 8) Run your wrapper as PID 1
ENTRYPOINT ["/bin/sh", "/srv/app/start_ckan.sh"]


